<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="420.0" spacing="12.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OfertasController">
   <children>
      <Label text="Mis candidaturas">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <HBox prefWidth="200.0" spacing="10.0">
         <children>
            <TextField fx:id="txtEmpresa" focusTraversable="false" promptText="Buscar por empresa" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="cmbEstado" prefWidth="140.0" promptText="Estado" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="txtSalarioMinimo" focusTraversable="false" onAction="#aplicarFiltros" promptText="Salario mínimo" HBox.hgrow="ALWAYS" />
            <DatePicker fx:id="dpDesde" prefWidth="140.0" promptText="Desde" />
         </children>
      </HBox>
      <TableView fx:id="tblOfertas" fixedCellSize="35.0" prefHeight="476.0" prefWidth="388.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTitulo" prefWidth="150.0" text="Título" />
          <TableColumn fx:id="colEmpresa" minWidth="70.0" prefWidth="90.0" text="Empresa" />
            <TableColumn fx:id="colEstado" minWidth="75.0" prefWidth="85.0" text="Estado" />
            <TableColumn fx:id="colFecha" minWidth="75.0" prefWidth="85.0" text="Fecha" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox spacing="10.0">
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#nuevaOferta" text="Nueva" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#verOferta" text="Ver" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#editarOferta" text="Editar" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#borrarOferta" text="Borrar" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#importarCsv" text="Importar CSV" />
         </children>
      </HBox>
      <HBox prefHeight="149.0" prefWidth="388.0">
         <children>
            <Button fx:id="btnEmpresas" mnemonicParsing="false" onAction="#empresa" prefHeight="45.0" prefWidth="135.0" style="-fx-background-radius: 12;" text="Empresas">
               <HBox.margin>
                  <Insets left="20.0" top="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnEntrevista" layoutX="30.0" layoutY="30.0" mnemonicParsing="false" onAction="#entrevista" prefHeight="45.0" prefWidth="135.0" style="-fx-background-radius: 12;" text="Entrevistas">
               <HBox.margin>
                  <Insets left="80.0" top="20.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
</VBox>
