<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="420.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OfertasController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <children>
        <Label text="Mis candidaturas">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <TextField fx:id="txtBuscar" promptText="Buscar por título o empresa" />
        <HBox spacing="8.0">
            <children>
                <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#limpiarFiltros" text="Limpiar" />
            </children>
        </HBox>
        <TableView fx:id="tablaOfertas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitulo" prefWidth="130.0" text="Título" />
                <TableColumn fx:id="colEmpresa" prefWidth="90.0" text="Empresa" />
                <TableColumn fx:id="colEstado" prefWidth="80.0" text="Estado" />
                <TableColumn fx:id="colFecha" prefWidth="85.0" text="Fecha" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER" spacing="8.0">
            <children>
                <Button mnemonicParsing="false" onAction="#nuevaOferta" text="Nueva" />
                <Button mnemonicParsing="false" onAction="#verOferta" text="Ver" />
                <Button mnemonicParsing="false" onAction="#editarOferta" text="Editar" />
                <Button mnemonicParsing="false" onAction="#borrarOferta" text="Borrar" />
            </children>
        </HBox>
        <Label fx:id="lblMensaje" />
    </children>
</VBox>
