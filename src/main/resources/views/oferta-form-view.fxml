<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="420.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OfertaFormController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <Label fx:id="lblTitulo" text="Nueva Oferta">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label text="Empresa*" />
      <ComboBox fx:id="cmbEmpresa" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Elige una empresa" />
      <Label text="Título*" />
      <TextField fx:id="txtTitulo" promptText="Puesto de la Oferta" />
      <Label text="Estado*" />
      <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Elige un estado" />
      <Label text="Fecha de postulación" />
      <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" promptText="Elige una fecha" />
      <Label text="Salario anual" />
      <TextField fx:id="txtSalario" promptText="Por ejemplo 25000" />
      <Label text="Enlace a la oferta" />
      <TextField fx:id="txtEnlace" promptText="https://" />
      <Label text="Notas" />
      <TextArea fx:id="txtNotas" prefHeight="90.0" prefWidth="200.0" promptText="Comentarios sobre la oferta" wrapText="true" />
      <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
      <HBox spacing="10.0">
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarOferta" text="Guardar" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>
