<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="420.0" spacing="12.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EmpresasController">
   <children>
      <Label text="Empresas">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <HBox prefWidth="200.0" spacing="10.0">
         <children>
            <TextField fx:id="txtBuscar" promptText="Buscar por empresa" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <TableView fx:id="tblEmpresas" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colSector" prefWidth="75.0" text="Sector" />
            <TableColumn fx:id="colWeb" prefWidth="75.0" text="Web" />
            <TableColumn fx:id="colRegistro" prefWidth="75.0" text="Registro" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox spacing="10.0">
         <children>
            <Button fx:id="btnNueva" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#nuevaEmpresa" text="Nueva" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnEditar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#editarEmpresa" text="Editar" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBorrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#borrarEmpresa" text="Borrar" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox prefHeight="149.0" prefWidth="388.0">
         <children>
            <Button fx:id="btnCandidaturas" mnemonicParsing="false" onAction="#candidatura" prefHeight="45.0" prefWidth="135.0" style="-fx-background-radius: 12;" text="Candidaturas">
               <HBox.margin>
                  <Insets left="20.0" top="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnEntrevista" layoutX="30.0" layoutY="30.0" mnemonicParsing="false" onAction="#entrevista" prefHeight="45.0" prefWidth="135.0" style="-fx-background-radius: 12;" text="Entrevistas">
               <HBox.margin>
                  <Insets left="80.0" top="20.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
</VBox>
