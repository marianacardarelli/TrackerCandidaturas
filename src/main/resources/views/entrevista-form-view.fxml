<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EntrevistaFormController">
   <children>
      <Label text="Nueva Entrevista">
         <font>
            <Font name="System Bold Italic" size="24.0" />
         </font>
         <VBox.margin>
            <Insets left="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      <Label text="Oferta*">
         <VBox.margin>
            <Insets left="10.0" top="10.0" />
         </VBox.margin>
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cmbOferta" prefWidth="400.0" promptText="Selecciona una candidatura">
         <VBox.margin>
            <Insets left="20.0" right="20.0" top="10.0" />
         </VBox.margin>
      </ComboBox>
      <Label layoutX="20.0" layoutY="69.0" text="Fecha*">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets left="10.0" top="10.0" />
         </VBox.margin>
      </Label>
      <DatePicker fx:id="dpFecha" prefWidth="200.0" promptText="dd/mm/aa">
         <VBox.margin>
            <Insets left="20.0" top="10.0" />
         </VBox.margin>
      </DatePicker>
      <Label layoutX="20.0" layoutY="133.0" text="Tipo*">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets left="10.0" top="10.0" />
         </VBox.margin>
      </Label>
      <ComboBox fx:id="cmbTipo" layoutX="30.0" layoutY="97.0" prefWidth="400.0" promptText="Selecciona un Tipo">
         <VBox.margin>
            <Insets left="20.0" right="20.0" top="10.0" />
         </VBox.margin>
      </ComboBox>
      <Label layoutX="20.0" layoutY="197.0" text="Resultado*">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets left="10.0" top="10.0" />
         </VBox.margin>
      </Label>
      <ComboBox fx:id="cmbResultado" layoutX="30.0" layoutY="225.0" prefWidth="400.0" promptText="Selecciona un Resultado">
         <VBox.margin>
            <Insets left="20.0" right="20.0" top="10.0" />
         </VBox.margin>
      </ComboBox>
      <Label layoutX="20.0" layoutY="261.0" text="Notas">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets left="10.0" top="20.0" />
         </VBox.margin>
      </Label>
      <TextArea fx:id="txtNotas" prefHeight="150.0" prefWidth="200.0" promptText="Escribe una nota ...">
         <VBox.margin>
            <Insets left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </TextArea>
      <Label fx:id="lblError" text="Si hay algún error al agregar te saldrá aquí">
         <VBox.margin>
            <Insets left="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      <HBox>
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" prefHeight="60.0" prefWidth="100.0" text="Cancelar">
               <HBox.margin>
                  <Insets top="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" prefHeight="60.0" prefWidth="100.0" text="Guardar">
               <HBox.margin>
                  <Insets left="140.0" top="20.0" />
               </HBox.margin>
            </Button>
         </children>
         <VBox.margin>
            <Insets left="40.0" right="40.0" top="20.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
