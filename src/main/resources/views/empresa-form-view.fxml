<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox prefHeight="700.0" prefWidth="420.0" spacing="12.0" styleClass="pantalla" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EmpresaFormController">
   <padding>
      <Insets top="16.0" />
   </padding>
   <children>
      <Label fx:id="titulo" text="Empresa">
         <font>
            <Font name="System Bold Italic" size="24.0" />
         </font>
         <VBox.margin>
            <Insets left="16.0" top="10.0" />
         </VBox.margin>
      </Label>
      <Label fx:id="lblNombre" text="Nombre*">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin>
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtNombre" prefHeight="26.0" prefWidth="420.0" promptText="Nombre De La Empresa">
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" top="10.0" />
         </padding>
      </TextField>
      <Label fx:id="lblSector" text="Sector*">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin>
      </Label>
      <ComboBox prefHeight="30.0" prefWidth="382.0">
         <VBox.margin>
            <Insets left="20.0" right="10.0" />
         </VBox.margin>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </ComboBox>
      <Label fx:id="lblweb" text="Web">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin>
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtWeb" layoutX="30.0" layoutY="107.0" prefHeight="26.0" prefWidth="420.0" promptText="https://">
         <padding>
            <Insets bottom="10.0" left="10.0" top="10.0" />
         </padding>
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
      </TextField>
      <Label fx:id="lblFecha" layoutX="30.0" layoutY="228.0" text="Fecha">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtFecha" layoutX="30.0" layoutY="107.0" prefHeight="26.0" prefWidth="420.0" promptText="Día/Mes/Año">
         <padding>
            <Insets bottom="10.0" left="10.0" top="10.0" />
         </padding>
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
      </TextField>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="60.0" prefWidth="100.0" text="Cancelar">
               <HBox.margin>
                  <Insets left="60.0" top="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnGuardar" layoutX="70.0" layoutY="30.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="100.0" text="Guardar">
               <HBox.margin>
                  <Insets left="80.0" top="20.0" />
               </HBox.margin>
            </Button>
         </children>
         <VBox.margin>
            <Insets top="150.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
