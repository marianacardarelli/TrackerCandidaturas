<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox prefHeight="700.0" prefWidth="420.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OfertaDetalleController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label fx:id="lblTitulo" text="Titulo de la Oferta">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label fx:id="lblEmpresa" text="Empresa">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblEstado" text="Estado">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblFecha" text="Fecha">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblSalario" text="Salario">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblEnlace" text="Enlace">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblNotas" text="Notas" wrapText="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label text="Entrevistas ">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <TableView fx:id="tblEntrevistas" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colFechaEntrevista" prefWidth="75.0" text="Fecha" />
          <TableColumn fx:id="colTipoEntrevista" prefWidth="75.0" text="Tipo" />
            <TableColumn fx:id="colResultadoEntrevista" prefWidth="75.0" text="Resultado" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
